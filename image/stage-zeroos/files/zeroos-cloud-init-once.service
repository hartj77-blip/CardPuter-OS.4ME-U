# ZeroOS: cloud-init applies the imager's first-boot settings (Wi-Fi, user,
# SSH key). After that one boot it only costs time and RAM, so turn it off.
[Unit]
Description=Disable cloud-init after first boot
After=cloud-final.service
ConditionPathExists=!/etc/cloud/cloud-init.disabled

[Service]
Type=oneshot
ExecStart=/usr/bin/touch /etc/cloud/cloud-init.disabled

# cloud-final.service runs after multi-user.target, so being wanted by
# multi-user.target while ordered after cloud-final was a loop: systemd
# dropped this unit ("deleted to break ordering cycle") and cloud-init ran
# on every boot. cloud-init.target is where cloud-final itself hangs.
[Install]
WantedBy=cloud-init.target
