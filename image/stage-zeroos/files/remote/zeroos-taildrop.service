# Receive files sent to the Cardputer with Taildrop into ~/Downloads, while
# Tailscale is on.
[Unit]
Description=Receive Taildrop files into ~/Downloads
BindsTo=tailscaled.service
After=tailscaled.service

[Service]
# uid 1000: pi, or the name set in Raspberry Pi Imager. systemd sets HOME.
User=1000
ExecStartPre=/bin/sh -c 'mkdir -p "$HOME/Downloads"'
ExecStart=/bin/sh -c 'exec /usr/bin/tailscale file get --loop --conflict=rename "$HOME/Downloads"'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=tailscaled.service
