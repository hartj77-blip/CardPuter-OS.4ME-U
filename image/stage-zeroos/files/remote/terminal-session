#!/bin/sh
# Runs on tty3 for the Terminal app: attach to tmux, optionally running a
# command (e.g. "ssh desktop") in a new window first.
cd "$HOME" || exit 1
export TERM=linux
# Ubuntu's terminal colours: aubergine background, Tango palette.
i=0
for rgb in 300a24 cc0000 4e9a06 c4a000 3465a4 75507b 06989a d3d7cf \
           555753 ef2929 8ae234 fce94f 729fcf ad7fa8 34e2e2 eeeeec; do
    printf '\033]P%x%s' "$i" "$rgb"
    i=$((i + 1))
done
printf '\033[2J\033[H'
cmdfile="$HOME/.cache/zeroos/terminal-cmd"
cmd=$(cat "$cmdfile" 2>/dev/null); rm -f "$cmdfile"
cmd=$(printf '%s' "$cmd" | sed 's/^ *//; s/ *$//')
conf=/etc/zeroos/tmux.conf
# No tmux on this card (flashed from an image that didn't have it): a plain
# shell is better than a terminal that closes at once. "exit" goes back.
if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is not installed, so this is a plain shell: nothing keeps running"
    echo "after you leave. Type exit to go back. To get tmux: sudo apt install tmux"
    [ -n "$cmd" ] && exec "${SHELL:-/bin/bash}" -lc "$cmd; echo; printf 'Press Enter to close'; read _"
    exec "${SHELL:-/bin/bash}" -l
fi
set --
if [ -n "$cmd" ]; then
    # Keep the window open after ssh ends, so errors stay readable.
    set -- -n "${cmd##* }" "$cmd; echo; printf 'Press Enter to close'; read _"
fi
if tmux -f "$conf" has-session -t main 2>/dev/null; then
    [ $# -gt 0 ] && tmux -f "$conf" new-window -t main "$@"
else
    # Start the tmux server in pi's user manager, not in this service: the
    # service is stopped (KillMode=mixed) when we leave the Terminal, and
    # the sessions must outlive it. Without the user manager, start it here.
    systemd-run --user --scope --quiet --collect \
        tmux -f "$conf" new-session -d -s main "$@" 2>/dev/null \
        || tmux -f "$conf" new-session -d -s main "$@"
fi
# Clear the console on the way out: tmux's "[detached ...]" line would
# otherwise flash on the screen the next time the Terminal opens.
tmux -f "$conf" attach-session -t main && { printf '\033[H\033[2J'; exit 0; }
# tmux would not attach: say so and give a plain shell, not a blank screen.
echo "tmux could not start, so this is a plain shell. Type exit to go back."
exec "${SHELL:-/bin/bash}" -l
