#!/bin/sh
# console-on-lcd <tty-number>...: show these Linux consoles on the built-in
# screen. Run as root before the Terminal app's console is switched to.
#
# A console draws on the framebuffer it is mapped to, and that is not always
# the LCD: with a monitor connected at boot HDMI is fb0, and a card flashed
# from an older image still boots with fbcon=map:1 while the LCD is now fb0.
# The console then opens somewhere nobody is looking and the LCD shows
# nothing. Ask the kernel to put it on the LCD, whichever number that got.
#
# ZEROOS_FB_ROOT is for tests: a folder standing in for /.
R=${ZEROOS_FB_ROOT:-}
fb=$(readlink "$R/dev/fb_lcd" 2>/dev/null)
n=${fb##*fb}
case $n in
    ''|*[!0-9]*)
        n=""
        for c in "$R"/sys/class/graphics/fb[0-9]*/device/of_node/compatible; do
            [ -r "$c" ] || continue
            if tr '\0' '\n' < "$c" | grep -q st7789v; then
                n=${c#"$R"/sys/class/graphics/fb}; n=${n%%/*}
                break
            fi
        done ;;
esac
[ -n "$n" ] || { echo "zeroos: console-on-lcd: can't find the LCD's framebuffer" >&2; exit 0; }
# The framebuffer console lets go of every console when the framebuffer it
# started on goes away (HDMI's, when nothing is plugged in at boot): it is
# then unbound, consoles draw on the dummy driver, and the LCD shows nothing
# however they are mapped. Bind it again.
for v in "$R"/sys/class/vtconsole/vtcon*; do
    grep -qs "frame buffer" "$v/name" || continue
    [ "$(cat "$v/bind" 2>/dev/null)" = 1 ] || echo 1 > "$v/bind" ||
        echo "zeroos: console-on-lcd: could not bind the framebuffer console" >&2
done
# The console font (Terminus 6x12: 53 x 14) is set at boot, which was too
# early if the framebuffer console wasn't bound then. Set it on each console.
font=""
if [ -r "$R/etc/default/console-setup" ]; then
    face=$(sed -n 's/^FONTFACE="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$R/etc/default/console-setup")
    size=$(sed -n 's/^FONTSIZE="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$R/etc/default/console-setup")
    # console-setup writes 6x12 for a font file named 12x6.
    [ -n "$face" ] && [ -n "$size" ] && font="$R/usr/share/consolefonts/Uni2-$face${size#*x}x${size%x*}.psf.gz"
fi
[ -r "$font" ] || font="$R/usr/share/consolefonts/Uni2-Terminus12x6.psf.gz"
# con2fbmap (the fbset package) opens /dev/fb0, which is missing when the
# LCD is fb1 and HDMI is gone; the same request by hand works on any card.
map_to_lcd() {
    if command -v con2fbmap >/dev/null 2>&1 && con2fbmap "$1" "$n" 2>/dev/null; then return 0; fi
    python3 - "$1" "$n" "$R/dev/fb$n" <<'PY'
import fcntl, struct, sys
with open(sys.argv[3], "rb") as f:
    fcntl.ioctl(f, 0x4610, struct.pack("II", int(sys.argv[1]), int(sys.argv[2])))   # FBIOPUT_CON2FBMAP
PY
}
for tty; do
    case $tty in ''|*[!0-9]*) continue ;; esac
    map_to_lcd "$tty" || echo "zeroos: console-on-lcd: could not move tty$tty to fb$n" >&2
    if [ -r "$font" ] && command -v setfont >/dev/null 2>&1; then
        setfont -C "$R/dev/tty$tty" "$font" ||
            echo "zeroos: console-on-lcd: could not set the font on tty$tty" >&2
    fi
done
exit 0
