# The Terminal app: tmux on the Linux console (tty3), on the built-in screen.
# ZeroShell starts this and steps aside; when tmux detaches (Ctrl+Q) or the
# last shell exits, we switch back to ZeroShell on tty1. terminal-session
# starts the tmux server in pi's user manager (pi lingers), outside this
# service, so sessions and SSH connections survive the service stopping.
# systemd 257 refuses KillMode=process together with PAMName=, so this is
# mixed: SIGTERM to tmux attach, SIGKILL to anything left in the service.
[Unit]
Description=ZeroOS terminal on the built-in screen

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty3
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
UtmpIdentifier=tty3
UtmpMode=user
# The console must be on the LCD, not on HDMI or a framebuffer that isn't there.
ExecStartPre=-+/usr/lib/zeroos/console-on-lcd 3
ExecStartPre=+/bin/chvt 3
ExecStart=/usr/lib/zeroos/terminal-session
ExecStopPost=+/bin/chvt 1
KillMode=mixed
Restart=no
