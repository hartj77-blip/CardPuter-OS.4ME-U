// Router mode (docs/ROUTER.md): the Router app (ZeroShell, as pi) turns it
// on and off. Installed with the Router app.
polkit.addRule(function(action, subject) {
    if (subject.user != "pi" || action.id != "org.freedesktop.systemd1.manage-units") return;
    var unit = action.lookup("unit");
    if (unit == "zeroos-router@ethernet.service" || unit == "zeroos-router@usb.service") {
        return polkit.Result.YES;
    }
});
