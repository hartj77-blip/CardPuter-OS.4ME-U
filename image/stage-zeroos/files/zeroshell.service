[Unit]
Description=ZeroShell (Cardputer Zero home screen)
After=systemd-user-sessions.service NetworkManager.service sound.target
# The UI user's session runs PipeWire (volume, mute, playback); see the linger file.
Wants=user@1000.service
After=user@1000.service
Conflicts=getty@tty1.service
# ZeroShell exits when it has no screen to draw on; keep starting it.
StartLimitIntervalSec=0

[Service]
# uid 1000, not "pi": Raspberry Pi Imager renames pi to the username set in
# its settings (same uid), and a name here would then stop the UI starting.
# systemd sets HOME and USER from the user's real entry.
User=1000
Group=1000
SupplementaryGroups=video input audio netdev i2c gpio bluetooth
Environment=XDG_RUNTIME_DIR=/run/user/1000
# tty1 is ours: ZeroShell puts it in graphics mode with the keyboard off, so
# the console never draws over the UI and keys never pile up in it.
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
# ZeroShell finds the LCD itself (/dev/fb_lcd: fb0, or fb1 with a monitor).
# Set ZS_FRAMEBUFFER here only to force a framebuffer.
# "+" runs as root: open up the CPU speed and screen power files to video.
ExecStartPre=+/usr/lib/zeroos/power-perms
# The image lingers "pi"; after a rename that file names no one, so linger
# whoever uid 1000 is now (keeps PipeWire up between logins).
ExecStartPre=-+/bin/sh -c 'loginctl enable-linger "$(id -nu 1000)"'
ExecStart=/usr/bin/zeroshell
Restart=always
RestartSec=1
# The watchdog: ZeroShell's main loop pings systemd every 2.5 s
# (shell/src/platform/watchdog.cpp). If 10 s pass with no ping, the UI is
# stuck: systemd kills it (SIGABRT) and Restart=always starts it again.
# Slow shell commands on the UI thread raise the limit while they run.
WatchdogSec=10
NotifyAccess=main
# Keep the UI responsive under memory pressure (512 MB RAM).
OOMScoreAdjust=-500
Nice=-5

[Install]
WantedBy=multi-user.target
