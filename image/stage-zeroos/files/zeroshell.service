[Unit]
Description=ZeroShell (Cardputer Zero home screen)
After=systemd-user-sessions.service NetworkManager.service sound.target
# pi's user session runs PipeWire (volume, mute, playback); see the linger file.
Wants=user@1000.service
After=user@1000.service
Conflicts=getty@tty1.service
# ZeroShell exits when it has no screen to draw on; keep starting it.
StartLimitIntervalSec=0

[Service]
User=pi
Group=pi
SupplementaryGroups=video input audio netdev i2c gpio bluetooth
Environment=HOME=/home/pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
# tty1 is ours: ZeroShell puts it in graphics mode with the keyboard off, so
# the console never draws over the UI and keys never pile up in it.
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
# ZeroShell finds the LCD itself (/dev/fb_lcd: fb0, or fb1 with a monitor).
# Set ZS_FRAMEBUFFER here only to force a framebuffer.
# "+" runs as root: open up the CPU speed and screen power files to video.
ExecStartPre=+/usr/lib/zeroos/power-perms
ExecStart=/usr/bin/zeroshell
Restart=always
RestartSec=1
# Keep the UI responsive under memory pressure (512 MB RAM).
OOMScoreAdjust=-500
Nice=-5

[Install]
WantedBy=multi-user.target
