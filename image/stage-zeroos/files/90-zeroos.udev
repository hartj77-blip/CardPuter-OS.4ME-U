# Backlight and keyboard LEDs writable by the video group (ZeroShell runs as pi).
SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys%p/brightness", RUN+="/bin/chmod g+w /sys%p/brightness"
SUBSYSTEM=="leds", RUN+="/bin/chgrp video /sys%p/brightness", RUN+="/bin/chmod g+w /sys%p/brightness"
# IR transmit/receive for the IR Remote app.
SUBSYSTEM=="lirc", GROUP="video", MODE="0660"
SUBSYSTEM=="rc", RUN+="/bin/chgrp -R video /sys%p", RUN+="/bin/chmod -R g+w /sys%p"
# Boot text on the LCD. The console takes the first framebuffer, which is the
# LCD unless a monitor was connected at boot (then HDMI is fb0, the LCD fb1).
# Move tty1 onto the LCD whichever number it got, and tty3 (the Terminal app)
# with it. Same match as M5's fb_lcd rule.
SUBSYSTEM=="graphics", KERNEL=="fb[0-9]*", ATTRS{of_node/compatible}=="*st7789v*", RUN+="/usr/bin/con2fbmap 1 %n", RUN+="/usr/bin/con2fbmap 3 %n"
# M5Stack's apps draw on /dev/fb0: make that the LCD when nothing else is fb0.
SUBSYSTEM=="graphics", KERNEL=="fb[0-9]*", ACTION=="add|remove", RUN+="/usr/lib/zeroos/m5-fb0-link"
# Bluetooth on/off in Settings: rfkill (ZeroShell runs as pi, in netdev).
KERNEL=="rfkill", SUBSYSTEM=="misc", GROUP="netdev", MODE="0664"
