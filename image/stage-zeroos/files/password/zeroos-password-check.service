# Stops the "choose a new password" step once the default is gone
# (see /usr/lib/zeroos/first-password).
[Unit]
Description=ZeroOS: notice the default password has been changed
ConditionPathExists=/var/lib/zeroos/default-password

[Service]
Type=oneshot
ExecStart=/usr/lib/zeroos/password-check

[Install]
WantedBy=multi-user.target
