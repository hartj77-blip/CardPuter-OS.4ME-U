# passwd (or Raspberry Pi Imager's first-boot settings) rewrote /etc/shadow:
# check whether the default password is gone.
[Unit]
Description=ZeroOS: watch for the default password being changed
ConditionPathExists=/var/lib/zeroos/default-password

[Path]
PathModified=/etc/shadow
Unit=zeroos-password-check.service

[Install]
WantedBy=multi-user.target
