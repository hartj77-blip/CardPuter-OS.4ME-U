#!/bin/sh
# dock-keyboard on|off: give the Cardputer's own keyboard to the Dock desktop,
# or take it back.
#
# M5's image puts the built-in keyboard (the TCA8418 on the I2C bus) on its own
# seat, seat1 (/etc/udev/rules.d/99-ignore-i2c-key.rules), so a desktop
# session on seat0 never opens it; ZeroShell reads it directly. While docked,
# 99-zeroos-dock-keyboard.rules moves it to seat0 as long as the flag file
# below exists. zeroos-dock.service runs "on" before the desktop starts (so it
# finds the keyboard when it starts) and "off" after it stops. ZeroShell
# ignores keys while docked, so a key does one thing.
flag=/run/zeroos/dock-keyboard
case "$1" in
    on)  mkdir -p /run/zeroos && touch "$flag" ;;
    off) rm -f "$flag" ;;
    *)   echo "usage: dock-keyboard on|off" >&2; exit 2 ;;
esac
udevadm trigger --action=change --subsystem-match=input --property-match=ID_PATH=platform-3f804000.i2c
udevadm settle --timeout=3 || true
