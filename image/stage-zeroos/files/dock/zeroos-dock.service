# Dock mode: a small Wayland desktop (labwc) on the HDMI monitor, as the UI user
# (uid 1000: pi, or the name set in Raspberry Pi Imager).
# ZeroShell keeps running on the built-in screen. Started by ZeroShell (Dock
# app, or when a monitor is plugged in) or with `zeroos-dock start`.
[Unit]
Description=ZeroOS Dock mode (desktop on the HDMI monitor)
After=systemd-user-sessions.service zeroshell.service

[Service]
User=1000
# A logind session on tty2 gives labwc the HDMI display and input devices.
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty2
UtmpMode=user
# logind only makes a session active (and only then hands it the monitor and
# the keyboard and mouse) while its VT is the one in front. Without this the
# desktop ran on tty2 in the background and the monitor stayed blank. Switch
# first, so the session starts active; ZeroShell keeps drawing on the LCD
# whichever VT is in front.
ExecStartPre=+/bin/chvt 2
ExecStart=/usr/lib/zeroos/dock-session
# Back to ZeroShell's tty1, unless something else (the Terminal app) has
# already taken the front since.
ExecStopPost=+/bin/sh -c '[ "$(cat /sys/class/tty/tty0/active)" != tty2 ] || chvt 1'
Restart=no
# The desktop is what earlyoom should sacrifice first, never ZeroShell.
OOMScoreAdjust=200
