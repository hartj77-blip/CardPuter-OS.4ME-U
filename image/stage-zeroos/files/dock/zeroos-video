#!/bin/sh
# Video player for Dock mode. H.264 is decoded by the VideoCore hardware
# (V4L2 M2M); other formats fall back to the CPU. With no file given, show
# ~/Videos in the file manager.
#   zeroos-video [FILE|URL]
if [ $# -eq 0 ]; then
    # No file: show ~/Videos in the desktop's file manager (double-click plays).
    dir="$HOME/Videos"
    [ -d "$dir" ] || dir="$HOME"
    exec pcmanfm "$dir"
fi
# A Jellyfin stream from the Media app: its sign-in header (and where to
# start) are in a file only we can read, not on the command line.
case "$1" in
    http://*|https://*)
        opts="$HOME/.config/zeroos/jellyfin-mpv.conf"
        [ -r "$opts" ] && set -- --include="$opts" "$@" ;;
esac
exec mpv --hwdec=v4l2m2m-copy --hwdec-codecs=h264 \
    --cache=yes --demuxer-max-bytes=32MiB --demuxer-max-back-bytes=8MiB \
    --vd-lavc-threads=4 --keep-open=no --force-window=yes "$@"
