#!/bin/bash
# zeroos-apps: install and remove ZeroOS apps (docs/APPS.md).
#
#   zeroos-apps list                    what's on offer and what's installed
#   zeroos-apps refresh                 fetch the app lists from every source
#   zeroos-apps install <id>            download an app and install it (or update it)
#   zeroos-apps remove <id>             remove an app and the extras it brought
#   zeroos-apps upgrade                 update every installed app that has a newer version
#   zeroos-apps install-file X.deb      install an app package that is already here
#   zeroos-apps sources                 where apps come from
#   zeroos-apps add-source <owner/repo | https://... | m5stack>
#   zeroos-apps remove-source <owner/repo | https://... | m5stack>
#   zeroos-apps source-up <source>      move a source up the list (it wins over the ones below)
#   zeroos-apps source-down <source>    move a source down the list
#   zeroos-apps run <action[:arg]>      what zeroos-apps@<action[:arg]>.service runs
#
# A source is a GitHub repository (owner/repo) whose newest release holds
# zeroos-apps.index and the packages it lists, or any https:// address that
# serves the same. Each app is one Debian package, zeroos-app-<id>, holding
# the app's module (/usr/lib/zeroos/apps/<id>.so) and its own extras; apt
# pulls in the Debian packages it depends on, and takes them away again on
# removal. The download is checked against the index's SHA-256.
#
# A source can also be M5Stack's own app store (the word m5stack, or the
# address of its registry.json): its apps are Debian packages made for M5's
# launcher, which put a .desktop file in /usr/share/APPLaunch/applications.
# They appear here as m5-<package>, are installed and removed the same way,
# and ZeroShell opens them full screen (docs/APPS.md, "M5Stack's app store").
#
# Everything but list, sources and status needs root. ZeroShell's Apps app
# starts zeroos-apps@<action>.service and reads /run/zeroos/apps.status.
set -u

SOURCES=${ZEROOS_APPS_SOURCES:-/etc/zeroos/apps.sources}
STATE_DIR=${ZEROOS_APPS_STATE:-/var/lib/zeroos/apps}
CACHE=${ZEROOS_APPS_CACHE:-/var/cache/zeroos/apps}
RUN_DIR=${ZEROOS_APPS_RUN:-/run/zeroos}
ZEROSHELL=${ZEROOS_APPS_ZEROSHELL:-/usr/bin/zeroshell}
CATALOG=$STATE_DIR/catalog
STATUS=$RUN_DIR/apps.status
INDEX=zeroos-apps.index
VERIFY=${ZEROOS_VERIFY:-/usr/lib/zeroos/verify}
ROOTDIR=${ZEROOS_APPS_ROOT:-}   # tests only: where apt source files go
M5_REGISTRY=${ZEROOS_APPS_M5_REGISTRY:-/usr/lib/zeroos/m5-registry}
# M5 moved the list to cardputer.cc in November 2026. The old address now
# redirects to plain http, which curl --proto-redir =https refuses, so a
# sources line with the old address is read as the new one.
M5_STORE=https://cardputer.cc/generated/registry.json
M5_STORE_OLD=https://cardputerzero.github.io/generated/registry.json
M5_DIR=$STATE_DIR/m5            # m5-<package>: what ZeroShell reads to list it
M5_DESKTOP=/usr/share/APPLaunch/applications

action="" app="" last_state=""

log() { echo "zeroos-apps: $*" >&2; }

# status <state> [percent] [message]
# States: refreshing, downloading, installing, removing, done, failed, offline.
status() {
    last_state=$1
    mkdir -p "$RUN_DIR" 2>/dev/null || return 0
    local tmp="$STATUS.tmp.$$"
    {
        echo "state=$1"
        echo "action=$action"
        echo "app=$app"
        echo "percent=${2:-0}"
        echo "message=${3:-}"
    } > "$tmp" 2>/dev/null && chmod 0644 "$tmp" && mv -f "$tmp" "$STATUS"
    log "$1${app:+ $app}${3:+: $3}"
}

fail() {
    status failed 0 "$1"
    exit 1
}

on_exit() {
    local rc=$?
    case $last_state in
        refreshing|downloading|installing|removing)
            status failed 0 "Stopped unexpectedly (code $rc). Try again" ;;
    esac
}

need_root() {
    [ "$(id -u)" = 0 ] || { echo "zeroos-apps: $1 needs root (try: sudo zeroos-apps $1)" >&2; exit 1; }
}

setup() {
    mkdir -p "$RUN_DIR" "$STATE_DIR" "$CACHE" || exit 1
    exec 9> "$RUN_DIR/apps.lock"
    flock -n 9 || { echo "zeroos-apps: another job is running" >&2; exit 1; }
    export DEBIAN_FRONTEND=noninteractive
}

# The app ABI of this ZeroShell: modules built for another one won't load.
app_abi() {
    local abi
    abi=$("$ZEROSHELL" --app-abi 2>/dev/null)
    if [[ $abi =~ ^[0-9]+$ ]]; then echo "$abi"; else echo 1; fi
}

# A source line -> the address its files are under, or nothing if it's no source.
source_url() {
    local s=$1
    [ "$s" = m5stack ] || [ "${s%/}" = "$M5_STORE_OLD" ] && s=$M5_STORE
    if [[ $s =~ ^https://[^[:space:]\'\"\\]+$ ]]; then
        echo "${s%/}"
    elif [ "${ZEROOS_APPS_ALLOW_FILE:-0}" = 1 ] && [[ $s =~ ^file:///[^[:space:]\'\"\\]+$ ]]; then
        echo "${s%/}"   # tests only
    elif [[ $s =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]; then
        echo "https://github.com/$s/releases/latest/download"
    fi
}

# A source whose address is a .json file is an M5Stack-style app store.
is_m5_store() { [[ $1 == *.json ]]; }

list_sources() {
    [ -r "$SOURCES" ] || return 0
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$SOURCES" | awk 'NF'
}

# Check one index and print its usable blocks, with source= added. Nothing in
# it is run or sourced; a block that isn't the expected shape is dropped, and
# so is one built for another app ABI or another kind of computer.
filter_index() {
    local src=$1 abi=$2 arch=$3
    awk -v src="$src" -v abi="$abi" -v arch="$arch" '
        function flush(   n, k, i) {
            if (id != "" && ok && v["abi"] == abi \
                && v["file"] ~ ("^zeroos-app-" id "_[0-9][0-9A-Za-z.+~-]*_(" arch "|all)\\.deb$") \
                && v["version"] ~ /^[0-9][0-9A-Za-z.+~-]*$/ && v["sha256"] ~ /^[0-9a-f]+$/ \
                && length(v["sha256"]) == 64 && v["size"] ~ /^[0-9]+$/ \
                && (v["extra-file"] == "" || (v["extra-file"] ~ /^[A-Za-z0-9][A-Za-z0-9_.+~-]*\.deb$/ \
                    && v["extra-url"] ~ /^https:\/\/[^ \047"\\]+$/ && v["extra-sha256"] ~ /^[0-9a-f]+$/ \
                    && length(v["extra-sha256"]) == 64)) \
                && (v["replaces"] == "" || v["replaces"] ~ /^[a-z0-9][a-z0-9-]*( [a-z0-9][a-z0-9-]*)*$/)) {
                printf "app=%s\n", id
                n = split("name summary version abi file sha256 size needs extra-file extra-url extra-sha256 replaces", k, " ")
                for (i = 1; i <= n; i++) if (v[k[i]] != "") printf "%s=%s\n", k[i], v[k[i]]
                printf "source=%s\n\n", src
            }
            id = ""; ok = 1; split("", v)
        }
        BEGIN { ok = 1 }
        /^[[:space:]]*$/ { flush(); next }
        /^#/ { next }
        {
            eq = index($0, "=")
            if (eq < 2) { ok = 0; next }
            key = substr($0, 1, eq - 1); val = substr($0, eq + 1)
            gsub(/[[:cntrl:]]/, "", val)
            if (key == "app") { if (val ~ /^[a-z0-9][a-z0-9-]*$/) id = val; else ok = 0 }
            else v[key] = substr(val, 1, 200)
        }
        END { flush() }'
}

refresh() {
    local abi arch tmp src url text n=0 reached=0 out idx rc
    abi=$(app_abi)
    arch=${ZEROOS_APPS_ARCH:-$(dpkg --print-architecture)}
    tmp=$(mktemp "$STATE_DIR/catalog.XXXXXX")
    status refreshing
    while read -r src; do
        url=$(source_url "$src")
        [ -n "$url" ] || { log "skipping $src: not owner/repo or https://"; continue; }
        n=$((n + 1))
        if is_m5_store "$url"; then
            if ! text=$(curl -fsSL --proto-redir =https --connect-timeout 10 --max-time 60 --retry 2 "$url"); then
                log "no app list from $src"
                continue
            fi
            reached=$((reached + 1))
            printf '%s' "$text" | "$M5_REGISTRY" "$src" "$arch" >> "$tmp" ||
                log "nothing usable in $src"
            printf '\n\n' >> "$tmp"
            continue
        fi
        idx=$(mktemp "$STATE_DIR/index.XXXXXX")
        if ! curl -fsSL --proto-redir =https --connect-timeout 10 --max-time 40 --retry 2 -o "$idx" "$url/$INDEX"; then
            log "no $INDEX from $src"
            rm -f -- "$idx"
            continue
        fi
        reached=$((reached + 1))
        # A source ZeroOS has a key for (zeroos-verify) must sign its index,
        # which holds every package's SHA-256. Others are taken as they are.
        rc=3
        if [ -x "$VERIFY" ]; then
            curl -fsSL --proto-redir =https --connect-timeout 10 --max-time 40 --retry 2 -o "$idx.sig" "$url/$INDEX.sig" ||
                rm -f -- "$idx.sig"
            rc=0
            "$VERIFY" "$src" "$idx" "$idx.sig" || rc=$?
        fi
        text=$(cat "$idx")
        rm -f -- "$idx" "$idx.sig"
        case $rc in
            0) log "$src: index signature checked" ;;
            3) ;;
            *) log "$src: the app list isn't signed with its key; skipping it"
               continue ;;
        esac
        printf '%s\n\n' "$text" | filter_index "$src" "$abi" "$arch" >> "$tmp"
    done < <(list_sources)
    if [ "$n" -gt 0 ] && [ "$reached" = 0 ]; then
        rm -f -- "${tmp:?}"
        status offline 0 "Can't reach GitHub"
        return 1
    fi
    # The first source to offer an app wins (the list is in order of trust).
    out=$(mktemp "$STATE_DIR/catalog.XXXXXX")
    awk -v RS= -v ORS='\n\n' '{ split($0, l, "\n"); if (!(l[1] in seen)) { seen[l[1]] = 1; print } }' \
        "$tmp" > "$out"
    chmod 0644 "$out"
    mv -f "$out" "$CATALOG"
    rm -f -- "${tmp:?}"
    status done 100
}

# field <id> <key>: one value from the catalog.
field() {
    [ -r "$CATALOG" ] || return 0
    awk -v RS= -v id="app=$1" -v key="$2=" '
        { n = split($0, l, "\n"); if (l[1] != id) next
          for (i = 2; i <= n; i++) if (index(l[i], key) == 1) { print substr(l[i], length(key) + 1); exit } }' "$CATALOG"
}

installed_version() {
    local pkg="zeroos-app-$1"
    if is_m5 "$1"; then
        pkg=$(m5_package "$1")
        [ -n "$pkg" ] || return 0
    fi
    dpkg-query -W -f '${db:Status-Abbrev} ${Version}\n' "$pkg" 2>/dev/null | awk '$1 == "ii" {print $2}'
}

# ---- M5Stack apps (m5-<package>) ----------------------------------------

is_m5() { [[ $1 == m5-* ]]; }

# The Debian package behind m5-<x>: from what we installed, or the catalog.
m5_package() {
    local p=""
    [ -r "$M5_DIR/$1" ] && p=$(sed -n 's/^package=//p' "$M5_DIR/$1" | head -n1)
    [ -n "$p" ] || p=$(field "$1" package)
    [[ $p =~ ^[a-z0-9][a-z0-9+.-]*$ ]] && echo "$p"
}

# m5_note <id> <package>: write down what ZeroShell needs to list the app:
# its package and the launcher entries (.desktop files) it installed.
m5_note() {
    local id=$1 pkg=$2 tmp
    mkdir -p "$M5_DIR"
    tmp=$(mktemp "$M5_DIR/.note.XXXXXX")
    {
        echo "package=$pkg"
        dpkg-query -L "$pkg" 2>/dev/null | grep -E "^$M5_DESKTOP/[^/]+\.desktop\$" | sed 's/^/desktop=/'
    } > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$M5_DIR/$id"
    grep -q '^desktop=' "$M5_DIR/$id" || log "$pkg has no launcher entry; it won't be on the home screen"
}

# install_m5 <id> <deb>: an M5Stack app package, checked against the catalog.
install_m5() {
    local id=$1 deb=$2 pkg want arch ver
    pkg=$(dpkg-deb -f "$deb" Package 2>/dev/null)
    arch=$(dpkg-deb -f "$deb" Architecture 2>/dev/null)
    ver=$(dpkg-deb -f "$deb" Version 2>/dev/null)
    want=$(m5_package "$id")
    [ -n "$pkg" ] && { [ -z "$want" ] || [ "$pkg" = "$want" ]; } || fail "Not the package for $id"
    # ZeroOS's own packages are never replaced from here.
    case $pkg in zeroos|zeroos-*) fail "Not an M5Stack app" ;; esac
    # Nor is any other package already on the device that didn't come from
    # M5Stack's store (sudo, openssh-server...): the catalog isn't ours, and a
    # package of the same name, or one that replaces, conflicts with or breaks
    # it, would take its place as root.
    local rel name
    rel=$(dpkg-deb -f "$deb" Replaces Conflicts Breaks 2>/dev/null |
          sed -e 's/^[A-Za-z-]*: *//' | tr ',|' '\n\n' | sed -e 's/[[:space:]]*(.*//' -e 's/:.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    for name in "$pkg" $rel; do
        [[ $name =~ ^[a-z0-9][a-z0-9+.-]*$ ]] || continue
        is_installed_pkg "$name" || continue
        m5_managed | grep -qxF -- "$name" ||
            fail "$id would replace $name, which is already on this device and didn't come from M5Stack's store"
    done
    [ "$arch" = all ] || [ "$arch" = "$(dpkg --print-architecture)" ] ||
        fail "This app is for another kind of computer ($arch)"
    status installing 100
    case $deb in */*) ;; *) deb=./$deb ;; esac
    APT_GUARD=m5 apt_put_on "$deb" || fail "Could not install $id. Nothing else changed"
    apt-mark manual "$pkg" >&2 || true
    m5_note "$id" "$pkg"
    status done 100 "$id $ver installed"
}

fetch_m5() {
    local id=$1 url sha size file
    url=$(field "$id" url)
    sha=$(field "$id" sha256)
    size=$(field "$id" size)
    file=${url##*/}
    { [[ $url =~ ^https://[^[:space:]\'\"\\]+$ ]] ||
      { [ "${ZEROOS_APPS_ALLOW_FILE:-0}" = 1 ] && [[ $url =~ ^file:///[^[:space:]\'\"\\]+$ ]]; }; } &&
        [[ $file =~ ^[A-Za-z0-9][A-Za-z0-9_.+~-]*\.deb$ ]] || fail "No source offers $id"
    status downloading 0
    download "$url" "$CACHE/$file" "${size:-0}" "$sha" || return 1
    install_m5 "$id" "$CACHE/$file"
    rm -f -- "${CACHE:?}/${file:?}"
}

remove_m5() {
    local id=$1 pkg
    pkg=$(m5_package "$id")
    status removing 100
    dpkg --configure -a >&2 || true
    if [ -n "$pkg" ]; then
        apt-get purge -y "$pkg" >&2 || fail "Could not remove $id"
    fi
    rm -f -- "$M5_DIR/$id"
    apt-get autoremove --purge -y >&2 || log "autoremove failed; extras may be left"
    status done 100 "$id removed"
}

is_installed_pkg() {
    dpkg-query -W -f '${db:Status-Abbrev}\n' "$1" 2>/dev/null | grep -q '^ii'
}

# The Debian packages installed from M5Stack's store, one per line.
m5_managed() {
    local f
    [ -d "$M5_DIR" ] || return 0
    for f in "$M5_DIR"/m5-*; do
        [ -f "$f" ] && sed -n 's/^package=//p' "$f" | head -n1
    done
}

# apt_guard_ok <apt-get install args>: with APT_GUARD=m5, apt's own dry run
# must not take anything off but other M5Stack apps. A package from a
# catalog we don't control could otherwise pull out system packages through
# its dependencies. If the dry run itself fails, so will the install.
apt_guard_ok() {
    [ "${APT_GUARD:-}" = m5 ] || return 0
    local out pkg allowed
    out=$(apt-get -s install -y --no-install-recommends "$@" 2>/dev/null) || return 0
    allowed=$(m5_managed)
    for pkg in $(printf '%s\n' "$out" | awk '$1 == "Remv" {print $2}'); do
        printf '%s\n' "$allowed" | grep -qxF -- "$pkg" && continue
        fail "Not installed: it would remove $pkg from this device. Nothing changed"
    done
}

# Installed M5Stack apps: "<id> <version>" each.
m5_installed() {
    local f id ver
    [ -d "$M5_DIR" ] || return 0
    for f in "$M5_DIR"/m5-*; do
        [ -f "$f" ] || continue
        id=${f##*/}
        [[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
        ver=$(installed_version "$id")
        if [ -n "$ver" ]; then echo "$id $ver"; else rm -f -- "$f"; fi   # removed by hand: forget it
    done
}

# download <url> <out> <size> <sha256>: 0 when the file is here and checks
# out; 1 (and a message in dl_error) when it couldn't be fetched or was damaged.
dl_error=""
download() {
    local url=$1 out=$2 size=$3 sha=$4 pid got pct free
    free=$(df -Pk "$CACHE" | awk 'NR==2 {print $4}')
    [ "$((size * 3 / 1024))" -lt "${free:-0}" ] || fail "Not enough free space"
    rm -f -- "${out:?}"
    curl -fsSL --proto-redir =https --connect-timeout 10 --speed-limit 1000 --speed-time 60 \
        --retry 3 --retry-delay 2 -o "$out" "$url" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        got=$(stat -c %s "$out" 2>/dev/null || echo 0)
        pct=100
        [ "$size" -gt 0 ] && pct=$((got * 100 / size))
        [ "$pct" -gt 100 ] && pct=100
        status downloading "$pct"
        sleep 1
    done 2>/dev/null
    if ! wait "$pid"; then
        rm -f -- "${out:?}"; dl_error="The download stopped. Try again"; return 1
    fi
    if [ "$(sha256sum "$out" | cut -d' ' -f1)" != "$sha" ]; then
        rm -f -- "${out:?}"; dl_error="The download was damaged. Try again"; return 1
    fi
}

# Some apps need a Debian repository of their own (Remote: Tailscale; Mesh:
# Meshtastic). Their package carries the repository's list file and key;
# put those in place first so apt can find what the app depends on. Only
# files named for this app, in these two folders, are taken.
apt_sources_from() {
    local deb=$1 id=$2 dir files f
    dir=$(mktemp -d)
    if ! dpkg-deb -x "$deb" "$dir"; then
        rm -rf -- "${dir:?}"
        return 1
    fi
    files=$(cd "$dir" && find etc/apt/sources.list.d usr/share/keyrings -type f \
        \( -name "zeroos-app-$id.list" -o -name "zeroos-app-$id.sources" \
           -o -name "zeroos-app-$id.gpg" -o -name "zeroos-app-$id.asc" \) 2>/dev/null)
    for f in $files; do
        case $f in
            *.list|*.sources)
                apt_source_ok "$dir/$f" "$id" || {
                    rm -rf -- "${dir:?}"
                    fail "$id adds a package source apt can't check (it must name its own key, and not be marked trusted)"
                } ;;
        esac
    done
    for f in $files; do install -D -m 0644 "$dir/$f" "$ROOTDIR/$f"; done
    rm -rf -- "${dir:?}"
    [ -n "$files" ]
}

# apt_source_ok <file> <id>: an app's apt source must be checked by apt
# against the app's own key (usr/share/keyrings/zeroos-app-<id>.gpg|.asc),
# and nothing may switch that check off. Otherwise one app could let anyone
# who can reach that address replace any package on the device.
apt_source_ok() {
    local f=$1 id=$2 key
    key="/usr/share/keyrings/zeroos-app-$id\\.(gpg|asc)"
    # Anything that turns checking off, in either format.
    grep -qiE '(trusted|allow-insecure|allow-weak|allow-downgrade-to-insecure)[[:space:]]*[=:]' "$f" && return 1
    case $f in
        *.list)
            KEY=$key awk '
                BEGIN { key = ENVIRON["KEY"] }
                /^[[:space:]]*(#|$)/ { next }
                !/^[[:space:]]*deb(-src)?[[:space:]]/ { bad = 1; next }
                { if ($0 !~ "\\[[^]]*signed-by=" key "[] ]") bad = 1 }
                END { exit bad }' "$f" ;;
        *.sources)
            # deb822: one or more stanzas, each with Signed-By: our key.
            KEY=$key awk '
                BEGIN { RS = ""; key = ENVIRON["KEY"] }
                { n++; if ($0 !~ "(^|\n)[Ss]igned-[Bb]y:[[:space:]]*" key "[[:space:]]*(\n|$)") bad = 1 }
                END { exit (bad || !n) }' "$f" ;;
        *) return 1 ;;
    esac
}

# Apps built for an older app ABI (a ZeroOS update changed it). ZeroShell
# can't load them, and while they are installed apt refuses to install
# anything at all ("unmet dependencies"). Take them off and note them in the
# restore list, so update-all (U) puts the new builds back.
drop_stale_apps() {
    local abi stale id
    abi=$(app_abi)
    stale=$(dpkg-query -W -f '${db:Status-Abbrev} ${Package} ${Depends}\n' 'zeroos-app-*' 2>/dev/null |
            awk -v want="zeroos-app-abi-$abi" '
                $1 ~ /^i/ { for (i = 3; i <= NF; i++) { d = $i; sub(/,$/, "", d)
                    if (d ~ /^zeroos-app-abi-[0-9]+$/ && d != want) { print $2; break } } }')
    [ -n "$stale" ] || return 0
    for id in $stale; do
        id=${id#zeroos-app-}
        [[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
        log "$id was built for an older ZeroOS; taking it off (update-all puts it back)"
        echo "$id" >> "$STATE_DIR/restore"
        dpkg --remove "zeroos-app-$id" >&2 || log "could not take off $id"
    done
}

# apt_put_on <deb>...: install packages and what they depend on.
apt_put_on() {
    # Something left half installed (a power cut, an extra that would not set
    # up): try the usual repair before giving up, since there may be nobody
    # with a keyboard to do it.
    if ! dpkg --configure -a >&2; then
        log "the package system was left half done; repairing"
        apt-get -f install -y -o Dpkg::Options::=--force-confold >&2 || true
        dpkg --configure -a >&2 || fail "The package system needs repair first: sudo dpkg --configure -a"
    fi
    drop_stale_apps
    apt_guard_ok "$@" || return 1
    apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confold -o Acquire::Retries=3 "$@" >&2 &&
        return 0
    # Old or missing package lists (a fresh card has none): fetch them, try again.
    apt-get update -o Acquire::Retries=3 >&2 || true
    apt_guard_ok "$@" || return 1
    apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confold -o Acquire::Retries=3 "$@" >&2
}

# Extras installed before they were recorded (install_debs) were marked auto,
# and an autoremove would take them off. Record them and mark them manual.
# The package is the first part of the extra's file name (pkg_ver_arch.deb).
keep_extras() {
    local id xfile xpkg
    for id in $(dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' 'zeroos-app-*' 2>/dev/null |
                awk '$1 == "ii" {sub(/^zeroos-app-/, "", $2); print $2}'); do
        [ -e "$STATE_DIR/extras/$id" ] && continue
        xfile=$(field "$id" extra-file)
        [ -n "$xfile" ] || continue
        xpkg=$(echo "${xfile%%_*}" | tr 'A-Z' 'a-z')
        [[ $xpkg =~ ^[a-z0-9][a-z0-9+.-]*$ ]] || continue
        dpkg-query -W -f '${db:Status-Abbrev}' "$xpkg" 2>/dev/null | grep -q '^ii' || continue
        mkdir -p "$STATE_DIR/extras"
        echo "$xpkg" > "$STATE_DIR/extras/$id"
        apt-mark manual "$xpkg" >&2
    done
}

# install_debs <id> <app.deb> [extra.deb]
install_debs() {
    local id=$1 deb=$2 extra=${3:-} pkg arch ver xpkg
    pkg=$(dpkg-deb -f "$deb" Package 2>/dev/null)
    arch=$(dpkg-deb -f "$deb" Architecture 2>/dev/null)
    ver=$(dpkg-deb -f "$deb" Version 2>/dev/null)
    [ "$pkg" = "zeroos-app-$id" ] || fail "Not the package for $id"
    [ "$arch" = all ] || [ "$arch" = "$(dpkg --print-architecture)" ] ||
        fail "This app is for another kind of computer ($arch)"
    status installing 100
    if apt_sources_from "$deb" "$id"; then
        apt-get update -o Acquire::Retries=3 >&2 || fail "Can't reach the app's package repository"
    fi
    # apt treats an argument as a file only if it has a slash.
    case $deb in */*) ;; *) deb=./$deb ;; esac
    if [ -n "$extra" ]; then
        case $extra in */*) ;; *) extra=./$extra ;; esac
        xpkg=$(dpkg-deb -f "$extra" Package 2>/dev/null)
        apt_put_on "$extra" "$deb" || fail "Could not install $id. Nothing else changed"
        # The extra goes when the app goes (remove_app). Nothing depends on
        # it, so it must not be marked auto: any autoremove (another app
        # removed, Update all) would take it off while the app is still here.
        if [ -n "$xpkg" ]; then
            mkdir -p "$STATE_DIR/extras"
            echo "$xpkg" > "$STATE_DIR/extras/$id"
            apt-mark manual "$xpkg" >&2
        fi
    else
        apt_put_on "$deb" || fail "Could not install $id. Nothing else changed"
    fi
    status done 100 "$id $ver installed"
}

install_app() {
    local id=$1
    [[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "No such app: $id"
    [ -s "$CATALOG" ] || refresh || exit 1
    [ -n "$(field "$id" version)" ] || refresh || exit 1
    fetch_and_install "$id" && return 0
    # A source's files live in its newest release, so a saved list from
    # before that release names files that are gone (a 404). Fetch the
    # lists again and try once more before giving up.
    log "$dl_error; fetching the app lists again"
    refresh || exit 1
    fetch_and_install "$id" || fail "$dl_error"
}

# fetch_and_install <id>: download the app the catalog names and install it.
# 1 if a download failed (dl_error says why); any other failure exits.
fetch_and_install() {
    local id=$1 ver file sha size xfile xurl xsha base
    ver=$(field "$id" version)
    [ -n "$ver" ] || fail "No source offers $id"
    # Never back to an older version: a stale or replayed list could
    # otherwise put back one with a known hole. (zeroos-apps install-file, by
    # hand, still can.)
    local cur
    cur=""
    # (An M5Stack id counts only once the store installed it: a package of the
    # same name from elsewhere isn't this app. install_m5 refuses that.)
    if ! is_m5 "$id" || [ -r "$M5_DIR/$id" ]; then cur=$(installed_version "$id"); fi
    if [ -n "$cur" ] && dpkg --compare-versions "$ver" lt "$cur"; then
        fail "$id $cur is newer than the $ver on offer; keeping it"
    fi
    if [ "$(field "$id" kind)" = m5 ]; then
        fetch_m5 "$id"
        return
    fi
    file=$(field "$id" file)
    sha=$(field "$id" sha256)
    size=$(field "$id" size)
    base=$(source_url "$(field "$id" source)")
    [ -n "$base" ] || fail "No source offers $id"
    status downloading 0
    download "$base/$file" "$CACHE/$file" "$size" "$sha" || return 1
    xfile=$(field "$id" extra-file)
    xurl=$(field "$id" extra-url)
    xsha=$(field "$id" extra-sha256)
    if [ -n "$xfile" ]; then
        download "$xurl" "$CACHE/$xfile" 0 "$xsha" || { rm -f -- "${CACHE:?}/${file:?}"; return 1; }
        install_debs "$id" "$CACHE/$file" "$CACHE/$xfile"
        rm -f -- "${CACHE:?}/${xfile:?}"
    else
        install_debs "$id" "$CACHE/$file"
    fi
    rm -f -- "${CACHE:?}/${file:?}"
}

remove_app() {
    local id=$1
    [[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "No such app: $id"
    if [ -z "$(installed_version "$id")" ]; then
        rm -f -- "$M5_DIR/$id"
        status done 100 "$id is not installed"
        return 0
    fi
    if is_m5 "$id"; then
        remove_m5 "$id"
        return
    fi
    status removing 100
    dpkg --configure -a >&2 || true
    apt-get purge -y "zeroos-app-$id" >&2 || fail "Could not remove $id"
    # Its own extra (install_debs), unless another app brought the same one.
    local xpkg=""
    [ -r "$STATE_DIR/extras/$id" ] && xpkg=$(cat "$STATE_DIR/extras/$id")
    rm -f -- "$STATE_DIR/extras/$id"
    if [[ $xpkg =~ ^[a-z0-9][a-z0-9+.-]*$ ]] && ! grep -qxF -- "$xpkg" "$STATE_DIR"/extras/* 2>/dev/null; then
        apt-get purge -y "$xpkg" >&2 || log "could not remove $xpkg"
    fi
    # What it brought along (Tailscale, Syncthing...), unless another app needs it.
    keep_extras
    apt-get autoremove --purge -y >&2 || log "autoremove failed; extras may be left"
    status done 100 "$id removed"
}

upgrade_all() {
    local id ver have n=0 todo
    refresh || exit 1
    action=upgrade
    drop_stale_apps
    todo=$(dpkg-query -W -f '${db:Status-Abbrev} ${Package} ${Version}\n' 'zeroos-app-*' 2>/dev/null |
           awk '$1 == "ii" {sub(/^zeroos-app-/, "", $2); print $2, $3}'; m5_installed)
    while read -r id ver; do
        [ -n "$id" ] || continue
        have=$(field "$id" version)
        [ -n "$have" ] || continue
        if dpkg --compare-versions "$have" gt "$ver"; then
            app=$id
            install_app "$id"
            n=$((n + 1))
        fi
    done <<< "$todo"
    # A renamed app (replaces=<old id> in the index): install the new one in
    # place of the old. Its package conflicts with the old one, so apt takes
    # the old one off in the same step.
    local new olds o
    while read -r new olds; do
        [ -n "$new" ] && [ -z "$(installed_version "$new")" ] || continue
        for o in $olds; do
            [ -n "$(installed_version "$o")" ] || continue
            app=$new
            install_app "$new"
            [ -e "$STATE_DIR/extras/$o" ] && [ ! -e "$STATE_DIR/extras/$new" ] &&
                mv -f -- "$STATE_DIR/extras/$o" "$STATE_DIR/extras/$new"
            rm -f -- "$STATE_DIR/extras/$o"
            n=$((n + 1))
            break
        done
    done < <(awk -v RS= '{ n = split($0, l, "\n"); id = ""; r = ""
                for (i = 1; i <= n; i++) { if (l[i] ~ /^app=/) id = substr(l[i], 5)
                                           if (l[i] ~ /^replaces=/) r = substr(l[i], 10) }
                if (id != "" && r != "") print id, r }' "$CATALOG")
    # Apps that were part of ZeroOS before an update made them installable
    # (the zeroos package writes the list): put them back, once.
    if [ -s "$STATE_DIR/restore" ]; then
        for id in $(cat "$STATE_DIR/restore"); do
            [[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
            [ -z "$(installed_version "$id")" ] && [ -n "$(field "$id" version)" ] || continue
            app=$id
            install_app "$id"
            n=$((n + 1))
        done
        rm -f -- "$STATE_DIR/restore"
        # What the old builds brought along and nothing needs now (extras of
        # apps that no longer exist): give the space back. Everything a
        # restored app needs is still depended on, so it stays.
        keep_extras
        # No --purge: nobody asked for this, and purging wipes what the
        # extras keep (Tailscale's login: the device would leave the tailnet).
        apt-get autoremove -y >&2 || log "autoremove failed; old extras may be left"
    fi
    app=""
    status done 100 "$n app(s) updated"
}

add_source() {
    local s=$1
    s=${s#https://github.com/}
    s=${s%/}
    s=${s%.git}
    [ -n "$(source_url "$s")" ] || fail "Not a source: use owner/repo or an https:// address"
    if ! list_sources | grep -qxF -- "$s"; then
        mkdir -p "$(dirname "$SOURCES")"
        echo "$s" >> "$SOURCES"
    fi
    refresh
}

remove_source() {
    local s=$1 tmp
    [ -f "$SOURCES" ] || return 0
    tmp=$(mktemp)
    awk -v s="$s" '{ l = $0; sub(/^[ \t]+/, "", l); sub(/[ \t]+$/, "", l); if (l != s) print }' "$SOURCES" > "$tmp"
    cat "$tmp" > "$SOURCES"
    rm -f -- "${tmp:?}"
    refresh
}

# Swap a source with the one above (up) or below (down) it. Comments and
# blank lines stay where they are. The first source to offer an app wins,
# so the catalog is made again.
move_source() {
    local dir=$1 s=$2 tmp
    list_sources | grep -qxF -- "$s" || fail "Not one of your sources: $s"
    tmp=$(mktemp)
    awk -v s="$s" -v dir="$dir" '
        { line[NR] = $0; l = $0; sub(/#.*/, "", l); sub(/^[ \t]+/, "", l); sub(/[ \t]+$/, "", l)
          if (l != "") { src[++n] = NR; if (l == s && !found) { found = 1; at = n } } }
        END {
            t = dir == "up" ? at - 1 : at + 1
            if (found && t >= 1 && t <= n) { a = src[at]; b = src[t]; x = line[a]; line[a] = line[b]; line[b] = x }
            for (i = 1; i <= NR; i++) print line[i]
        }' "$SOURCES" > "$tmp"
    cat "$tmp" > "$SOURCES"
    rm -f -- "${tmp:?}"
    refresh
}

list() {
    local id
    printf '%-20s %-12s %-12s %s\n' APP INSTALLED OFFERED SOURCE
    {
        [ -r "$CATALOG" ] && awk -v RS= '{ split($0, l, "\n"); print substr(l[1], 5) }' "$CATALOG"
        dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' 'zeroos-app-*' 2>/dev/null |
            awk '$1 == "ii" {sub(/^zeroos-app-/, "", $2); print $2}'
        m5_installed | cut -d' ' -f1
    } | sort -u | while read -r id; do
        [ -n "$id" ] || continue
        printf '%-20s %-12s %-12s %s\n' "$id" "$(installed_version "$id")" "$(field "$id" version)" \
            "$(field "$id" source)"
    done
}

# One job: "install:media", "refresh", "add-source:owner/repo"...
job() {
    local words=$1 arg=""
    action=${words%%:*}
    [ "$action" != "$words" ] && arg=${words#*:}
    case $action in
        refresh) refresh ;;
        install) app=$arg; install_app "$arg" ;;
        remove) app=$arg; remove_app "$arg" ;;
        upgrade) upgrade_all ;;
        add-source) add_source "$arg" ;;
        remove-source) remove_source "$arg" ;;
        source-up) move_source up "$arg" ;;
        source-down) move_source down "$arg" ;;
        *) fail "Unknown job: $words" ;;
    esac
}

trap on_exit EXIT

case "${1:-}" in
    list) list ;;
    sources) list_sources ;;
    status) [ -r "$STATUS" ] && cat "$STATUS" ;;
    run)
        need_root run
        setup
        job "${2:-}"
        ;;
    refresh|upgrade)
        need_root "$1"
        setup
        job "$1"
        ;;
    install|remove|add-source|remove-source|source-up|source-down)
        need_root "$1"
        [ -n "${2:-}" ] || { echo "usage: zeroos-apps $1 <name>" >&2; exit 1; }
        setup
        job "$1:$2"
        ;;
    install-file)
        need_root install-file
        [ -f "${2:-}" ] || { echo "usage: zeroos-apps install-file <zeroos-app-x.deb>" >&2; exit 1; }
        setup
        action=install
        app=$(dpkg-deb -f "$2" Package 2>/dev/null | sed -n 's/^zeroos-app-//p')
        if [ -z "$app" ] && dpkg-deb -c "$2" 2>/dev/null | grep -qE "\.$M5_DESKTOP/[^/]+\.desktop\$"; then
            # An app made for M5Stack's launcher.
            pkg=$(dpkg-deb -f "$2" Package 2>/dev/null)
            app=m5-$(echo "$pkg" | sed 's/[^a-z0-9-]/-/g')
            mkdir -p "$M5_DIR" && echo "package=$pkg" > "$M5_DIR/$app"
            install_m5 "$app" "$2"
            exit 0
        fi
        [ -n "$app" ] || fail "Not a ZeroOS app package"
        install_debs "$app" "$2"
        ;;
    *)
        sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
