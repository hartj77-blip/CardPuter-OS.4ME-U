# IR Remote (docs/IR.md): a universal remote from Flipper-IRDB, and your own
# remotes learned button by button. The code database comes with the app.
NAME="IR Remote"
SUMMARY="A universal remote (about 2,000 remotes from Flipper-IRDB) and remotes you teach it"
DEPENDS="v4l-utils, ir-keytable"
payload() {
    # Built by image/apps/build.sh with tools/irdb/build_irdb.py.
    [ -f "$ZEROOS_IRDB/index.tsv" ] || { echo "error: no IR code database at $ZEROOS_IRDB" >&2; exit 1; }
    install -d "$D/usr/share/zeroos/ir"
    cp -r "$ZEROOS_IRDB/." "$D/usr/share/zeroos/ir/"
    find "$D/usr/share/zeroos/ir" -type d -exec chmod 0755 {} + -o -type f -exec chmod 0644 {} +
}
